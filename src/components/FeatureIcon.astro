---
interface Props {
  name: "scan" | "edit" | "pdf" | "share" | "offline" | "privacy";
}

const { name } = Astro.props;

const paths: Record<typeof name, string> = {
  scan:
    "M3 5.5V3.75A.75.75 0 0 1 3.75 3H5.5M11 3h1.25a.75.75 0 0 1 .75.75V5.5M13 11v1.25a.75.75 0 0 1-.75.75H11M5.5 13H3.75a.75.75 0 0 1-.75-.75V11M5 8h6",
  edit:
    "M10.5 3.5 12.5 5.5M4 12l6.2-6.2a1.4 1.4 0 0 1 2 0l.5.5a1.4 1.4 0 0 1 0 2L6.5 14H4v-2Z",
  pdf: "M4.5 2.75h5L12.5 5.75v7.5a.75.75 0 0 1-.75.75h-7.5a.75.75 0 0 1-.75-.75v-9.5a.75.75 0 0 1 .75-.75Zm4.75 0V5.5h2.75M6 9.25h4M6 11.5h3",
  share:
    "M8 9.5V3M8 3 5.75 5.25M8 3l2.25 2.25M3.5 9.5v2.75A.75.75 0 0 0 4.25 13h7.5a.75.75 0 0 0 .75-.75V9.5",
  offline:
    "M3.5 8.25c0-2.485 2.015-4.5 4.5-4.5s4.5 2.015 4.5 4.5M5.25 10.5 8 13.25 10.75 10.5M8 8v5.25",
  privacy:
    "M8 2.75 12.5 4.5v3.4c0 2.65-1.85 5.1-4.5 5.85-2.65-.75-4.5-3.2-4.5-5.85V4.5L8 2.75Zm0 3.5v3M8 11h.01",
};
---

<span class="card__icon" aria-hidden="true">
  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d={paths[name]}
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</span>
