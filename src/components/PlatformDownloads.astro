---
import { getPublishedStores } from "../site.config";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const stores = getPublishedStores();
---

<div class:list={["download-row", compact && "download-row--compact"]}>
  {
    stores.map((store, index) => (
      <a
        class:list={["btn", index === 0 ? "btn--primary" : "btn--secondary"]}
        href={store.href}
        rel="noopener noreferrer"
      >
        {store.cta}
      </a>
    ))
  }
</div>
