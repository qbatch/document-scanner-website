---
import { stores } from "../site.config";

interface Props {
  iosFirst?: boolean;
  compact?: boolean;
}

const { iosFirst = true, compact = false } = Astro.props;

const ordered = iosFirst
  ? [stores.ios, stores.android, stores.harmony]
  : [stores.android, stores.harmony, stores.ios];
---

<div class:list={["download-row", compact && "download-row--compact"]}>
  {
    ordered.map((store, index) => (
      <a
        class:list={["btn", index === 0 && iosFirst ? "btn--primary" : "btn--secondary"]}
        href={store.href}
        rel="noopener noreferrer"
      >
        {store.cta}
      </a>
    ))
  }
</div>
