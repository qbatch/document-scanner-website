---
import { site, stores } from "../site.config";
import { pathTo } from "../lib/paths";

const helpLinks = [
  { route: "/privacy", label: "Privacy" },
  { route: "/support", label: "Support" },
];

const storeLinks = [
  { href: stores.ios.href, label: stores.ios.name, external: true },
  { href: stores.android.href, label: stores.android.name, external: true },
  { href: stores.harmony.href, label: stores.harmony.name, external: true },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="footer-col footer-col--brand">
      <p class="footer-brand">{site.name}</p>
      <p class="footer-tagline">Document Scanner</p>
      <p class="footer-platforms">{site.platformsLabel}</p>
    </div>

    <nav class="footer-col" aria-label="Help and legal">
      <p class="footer-col__title">Help</p>
      <ul class="footer-menu">
        {
          helpLinks.map(({ route, label }) => (
            <li>
              <a href={pathTo(route)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Download">
      <p class="footer-col__title">Download</p>
      <ul class="footer-menu">
        {
          storeLinks.map(({ href, label, external }) => (
            <li>
              <a href={href} rel={external ? "noopener noreferrer" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-col footer-col--legal">
      <p class="footer-fine">
        Contact: use the support email on your platform’s store listing for help or privacy requests.
      </p>
      <p class="footer-fine footer-fine--copy">
        © {site.copyrightYear} {site.name}. Apple, Google, Huawei, and related marks are trademarks of their respective
        owners.
      </p>
    </div>
  </div>
</footer>
