---
import BrandMark from "./BrandMark.astro";
import { site } from "../site.config";
import { isActiveRoute, pathTo } from "../lib/paths";

const path = Astro.url.pathname;

const links = [
  { route: "/", label: "Home" },
  { route: "/privacy", label: "Privacy" },
  { route: "/support", label: "Support" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={pathTo("/")}>
      <BrandMark />
      <span class="brand__name">
        {site.name}<span class="brand__tag">Document Scanner</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          links.map(({ route, label }) => (
            <li>
              <a href={pathTo(route)} aria-current={isActiveRoute(path, route) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
